# Version control
.git
.gitignore
.gitattributes

# Dependencies (re-installed inside the image)
node_modules

# Environment files (must be injected at runtime, not baked into image)
.env
.env.*

# Committed secrets — defence in depth, do NOT ship into the image.
# Rotate this key in Firebase and load credentials via FIREBASE_SERVICE_ACCOUNT instead.
# src/config/truckast-app-firebase-adminsdk-*.json

# IDE / editor
.idea
.vscode
.claude
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Build / cache output
dist
build
out
coverage
.nyc_output

# Logs
logs
*.log
npm-debug.log*

# Temp files
tmp
temp
*.tmp
*.temp

# Docs / one-off scripts not needed in prod image
README.md
docs
scripts/test-*
scripts/verify-*
scripts/sendTestNotification.js
check-deduplication-setup.js

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
deploy
